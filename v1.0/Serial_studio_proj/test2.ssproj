        {
            "datasets": [
                {
                    "datasetId": 0,
                    "displayFormat": "0d",
                    "displayTickCount": 5,
                    "fft": false,
                    "fftMax": 55,
                    "fftMin": -45,
                    "fftSamples": 1024,
                    "fftSamplingRate": 1000,
                    "graph": false,
                    "groupId": 2,
                    "index": 4,
                    "led": false,
                    "ledHigh": 80,
                    "log": false,
