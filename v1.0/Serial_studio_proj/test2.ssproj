                    "widgetMin": 0,
                    "xAxis": -1
                },
                {
                    "datasetId": 1,
                    "displayFormat": "0d",
                    "displayTickCount": 5,
                    "fft": false,
                    "fftMax": 0,
                    "fftMin": 0,
                    "fftSamples": 256,
                    "fftSamplingRate": 100,
                    "graph": false,
                    "groupId": 3,
                    "index": 3,
                    "led": false,
                    "ledHigh": 80,
                    "log": false,
                    "numericValue": 0,
                    "plotMax": 0,
                    "plotMin": 0,
                    "title": "New Dataset (1)",
                    "transformCode": "/*\n * Define a transform(value) function that receives the live\n * dataset reading and returns a transformed number. If no\n * transform() function is defined, the raw value is kept\n * and nothing is saved with the project.\n *\n * Example:\n *   function transform(value) {\n *     return value * 0.01 + 273.15;\n *   }\n *\n * Globals declared at the top level persist between frames,\n * which is useful for filters, accumulators, and any other\n * stateful transform -- just like a frame parser script:\n *\n *   var alpha = 0.1;\n *   var ema;\n *\n *   function transform(value) {\n *     if (ema === undefined) ema = value;\n *     ema = alpha * value + (1 - alpha) * ema;\n *     return ema;\n *   }\n *\n * Use the Template dropdown for ready-made examples, or\n * click Test to try your function.\n */\n \n // Zmienne globalne, które \"żyją\" między kolejnymi próbkami\nvar sawCount = 0;\nvar isArmed = false;\n\nfunction transform(value) {\n    // 1. Jeśli sygnał osiągnie wysoką wartość (prawie koniec piły), uzbrajamy licznik\n    if (value > 350.0) {\n        isArmed = true;\n    }\n    \n    // 2. Jeśli sygnał był uzbrojony, a teraz gwałtownie spadł (np. poniżej 90 stopni), \n    // to znaczy, że piła zresetowała się do zera.\n    if (isArmed && value < 90.0) {\n        sawCount++;       // Zwiększamy licznik\n        isArmed = false;  // Rozbrajamy, czekając na kolejną piłę\n    }\n    \n    // Zwracamy zliczoną sumę zamiast surowego kąta theta\n    return sawCount;\n}",
                    "transformLanguage": 0,
                    "units": "",
                    "value": "",
                    "widget": "",
                    "widgetMax": 0,
                    "widgetMin": 0,
                    "xAxis": -1
                }
            ],
            "title": "Data Grid",
            "widget": "datagrid"
        }
    ],
