    "hexadecimalDelimiters": true,
    "pointCount": 100,
    "sources": [
        {
            "busType": 1,
            "checksum": "",
            "checksumAlgorithm": "",
            "connection": {
                "address": "192.168.1.15",
                "socketTypeIndex": 0,
                "tcpPort": 12345
            },
            "decoder": 3,
            "decoderMethod": 3,
            "frameDetection": 3,
            "frameEnd": "\\n",
            "frameParserCode": "/**\n * Raw Bytes Parser\n *\n * Parses raw binary data into an array of byte values (0-255).\n *\n * INPUT FORMAT: Binary frame data (QByteArray)\n * OUTPUT ARRAY: [0x12, 0x34, 0x56, 0x78, ...]\n *\n * Note: This parser requires Binary (Direct) decoder mode in the Project Editor.\n *       Frame delimiters are automatically removed by Serial Studio.\n */\n\n//------------------------------------------------------------------------------\n// Frame Parser Function\n//------------------------------------------------------------------------------\n\n/**\n * Parses a raw binary frame into an array of byte values.\n *\n * @param {array} frame - The raw binary data from the data source (byte array)\n * @returns {array} Array of byte values (0-255)\n */\nfunction parse(frame) {\n    // 1. Sprawdzamy, czy mamy wystarczająco dużo danych na 8 floaty (4 * 17 = 68 bajtów)\n    if (frame.length < 72) {\n        return []; \n    }\n    \n    // 2. Tworzymy większy bufor\n    let buffer = new ArrayBuffer(72);\n    let bytes = new Uint8Array(buffer);\n    \n    // 3. Przepisujemy 68 bajtów\n    for (let i = 0; i < 72; i++) {\n        bytes[i] = frame[i];\n    }\n    \n    // 4. Odczytujemy 17 floaty, przesuwając się co 4 bajty w pamięci\n    let view = new DataView(buffer);\n    let V_avg     = view.getFloat32(0, true);\n    let I_avg     = view.getFloat32(4, true); \n    let U_rms     = view.getFloat32(8, true); \n    let I_rms     = view.getFloat32(12, true); \n    let V1_rms    = view.getFloat32(16, true);\n    let I1_rms    = view.getFloat32(20, true); \n    let P         = view.getFloat32(24, true); \n    let P1        = view.getFloat32(28, true);\n    let Q1        = view.getFloat32(32, true);\n    let S         = view.getFloat32(36, true);\n    let S1        = view.getFloat32(40, true);\n    let PF        = view.getFloat32(44, true);\n    let DPF       = view.getFloat32(48, true);\n    let DF        = view.getFloat32(52, true);\n    let THD_u     = view.getFloat32(56, true);\n    let THD_i     = view.getFloat32(60, true);\n    let f         = view.getFloat32(64, true);\n    let Q         = view.getFloat32(68, true);\n     \n    // 5. Zwracamy 4 wartości\n    return [V_avg, I_avg, U_rms, I_rms, V1_rms, I1_rms, P, P1, Q1, S, S1, PF, DPF, DF, THD_u, THD_i, f, Q];\n    \n}",
            "frameStart": "AA AA",
            "hexadecimalDelimiters": true,
            "sourceId": 0,
            "title": "STM"
        }
    ],
