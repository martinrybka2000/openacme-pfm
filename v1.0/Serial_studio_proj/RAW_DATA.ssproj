    "sources": [
        {
            "busType": 1,
            "checksum": "",
            "checksumAlgorithm": "",
            "decoder": 3,
            "decoderMethod": 3,
            "frameDetection": 3,
            "frameEnd": "\\n",
            "frameParserCode": "/**\n * Raw Bytes Parser\n *\n * Parses raw binary data into an array of byte values (0-255).\n *\n * INPUT FORMAT: Binary frame data (QByteArray)\n * OUTPUT ARRAY: [0x12, 0x34, 0x56, 0x78, ...]\n *\n * Note: This parser requires Binary (Direct) decoder mode in the Project Editor.\n *       Frame delimiters are automatically removed by Serial Studio.\n */\n\n//------------------------------------------------------------------------------\n// Frame Parser Function\n//------------------------------------------------------------------------------\n\n/**\n * Parses a raw binary frame into an array of byte values.\n *\n * @param {array} frame - The raw binary data from the data source (byte array)\n * @returns {array} Array of byte values (0-255)\n */\nfunction parse(frame) {\n    // 1. Sprawdzamy, czy mamy wystarczająco dużo danych na 4 floaty (4 * 4 = 16 bajtów)\n    if (frame.length < 8) {\n        return []; \n    }\n    \n    // 2. Tworzymy większy bufor\n    let buffer = new ArrayBuffer(8);\n    let bytes = new Uint8Array(buffer);\n    \n    // 3. Przepisujemy 16 bajtów\n    for (let i = 0; i < 8; i++) {\n        bytes[i] = frame[i];\n    }\n    \n    // 4. Odczytujemy 4 floaty, przesuwając się co 4 bajty w pamięci\n    let view = new DataView(buffer);\n    let v_raw     = view.getFloat32(0, true);\n    let i_raw     = view.getFloat32(4, true); \n//    let pll_theta = view.getFloat32(8, true); \n//    let pll_omega = view.getFloat32(12, true); \n    \n    // 5. Zwracamy 4 wartości\n//    return [v_raw, i_raw, pll_theta, pll_omega];\n    return [v_raw, i_raw];\n}",
            "frameStart": "AA AA",
            "hexadecimalDelimiters": true,
            "sourceId": 0,
            "title": "STM"
        }
    ],
