    "sources": [
        {
            "busType": 0,
            "checksum": "",
            "checksumAlgorithm": "",
            "connection": {
                "autoReconnect": false,
                "baudRate": 115200,
                "dataBitsIndex": 3,
                "deviceId": {
                    "description": "STM32 Virtual ComPort",
                    "pid": "5740",
                    "portName": "COM9",
                    "serial": "336D34513532",
                    "vid": "0483"
                },
                "dtr": false,
                "flowControlIndex": 0,
                "parityIndex": 0,
                "portIndex": 1,
                "stopBitsIndex": 0
            },
            "decoder": 3,
            "decoderMethod": 3,
            "frameDetection": 3,
            "frameEnd": "\\n",
            "frameParserCode": "/**\n * Comma-Separated Values (CSV) Parser\n *\n * Parses comma-separated data into an array of values.\n *\n * INPUT FORMAT: \"a,b,c,d,e,f\"\n * OUTPUT ARRAY: [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\"]\n *\n * Note: Frame delimiters are automatically removed by Serial Studio.\n */\n\n//------------------------------------------------------------------------------\n// Frame Parser Function\n//------------------------------------------------------------------------------\n\n/**\n * Parses a CSV frame into an array of values.\n *\n * @param {string} frame - The CSV data from the data source\n * @returns {array} Array of string values\n */\nfunction parse(frame) {\n    // Sprawdzamy czy dotarło przynajmniej 22 bajtów struktury LiveFrame_t\n    if (frame.length < 22) {\n        return null; \n    }\n\n    let view = new DataView(frame.buffer, frame.byteOffset, frame.length);\n\n    // Dla pewności sprawdzamy nagłówek (czy na pewno zaczynamy od AA AA)\n    let sync = view.getUint16(0, true); \n    if (sync !== 0xAAAA) {\n        return null; \n    }\n\n    // Wyciągamy floaty z konkretnych offsetów pamięci (Little-Endian)\n    let v_raw     = view.getFloat32(2, true);\n    let i_raw     = view.getFloat32(6, true);\n    let pll_theta = view.getFloat32(10, true);\n    let pll_omega = view.getFloat32(14, true);\n    let v_d       = view.getFloat32(18, true);\n\n    // Zwracamy tablicę do wykresów\n    return [v_raw, i_raw, pll_theta, pll_omega, v_d];\n}",
            "frameStart": "AA AA",
            "hexadecimalDelimiters": true,
            "sourceId": 0,
            "title": "STM32"
        }
    ],
    "title": "test",
    "writerVersion": "3.2.7",
    "writerVersionAtCreation": "3.2.7"
}
